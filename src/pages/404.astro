---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Seite nicht gefunden" noindex>
  <header class="page-heading">
    <p class="eyebrow accent">404 · Hier geht es nicht weiter.</p>
    <h1>
      Ein anderer Weg
      <br />
      führt zur Antwort.
    </h1>
    <p>
      Diese Seite konnten wir nicht finden. Vielleicht hat sich ein Link
      geändert oder die Adresse enthält einen Tippfehler.
    </p>
    <a class="text-link" href="/suche/">
      Im Magazin suchen <span>↗</span>
    </a>
  </header>
  <section class="simple-content prose">
    <h2>Hier können Sie anfangen.</h2>
    <ul>
      <li>
        <a href="/">Zur Startseite</a>
      </li>
      <li>
        <a href="/magazin/">Alle Beiträge im Magazin</a>
      </li>
      <li>
        <a href="/budget-check/">Der Budget-Check</a>
      </li>
      <li>
        <a href="/kontakt/">Einen fehlerhaften Link melden</a>
      </li>
    </ul>
  </section>
</BaseLayout>
