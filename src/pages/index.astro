---
import BaseLayout from "../layouts/BaseLayout.astro";
import Art from "../components/Art.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { articles, minutes, pillarName, pillars } from "../lib/content";
const all = await articles();
const byId = (id: string) => all.find((a) => a.data.id === id)!;
const feature = byId("A01");
const rail = ["A07", "A10", "A15", "A06"];
const essentials = ["A02", "A03", "A11", "A12", "A14"];
const sections = [
  { pillar: "budgetieren", ids: ["A04", "A05"] },
  { pillar: "beantragen", ids: ["A13"] },
  { pillar: "begleiten", ids: ["A08", "A09"] },
  { pillar: "beobachten", ids: ["A16", "A17", "A18"] },
];
---

<BaseLayout title="Pflegebegleitung finanzieren und verstehen">
  <section class="lead-grid" aria-label="Die Startausgabe">
    <div class="lead-column lead-feature-column">
      <div class="lead-inner">
        <a class="feature-card" href={feature.data.route}>
          <Art
            id={feature.data.assetId}
            priority
            sizes="(min-width:1080px) 50vw, 100vw"
            decorative
          />
          <div class="feature-copy">
            <p class="eyebrow">Budgetieren · Der große Überblick</p>
            <h1>
              Pflegebegleitung finanzieren.
              <br />
              Ein klarer Weg durch Ihr Budget.
            </h1>
            <p>{feature.data.description}</p>
            <p class="reading-time">
              {minutes(feature)} Minuten Lesezeit{" "}
              <span aria-hidden="true">↗</span>
            </p>
          </div>
        </a>
      </div>
    </div>
    <aside
      class="lead-column lead-essentials-column"
      aria-labelledby="essentials-title"
    >
      <div class="lead-inner">
        <h2 id="essentials-title" class="eyebrow essentials-heading">
          Gut zu wissen
        </h2>
        <ol class="essentials">
          {essentials.map((id) => {
            const a = byId(id);
            return (
              <li>
                <p class="eyebrow accent">{a.data.format}</p>
                <h2>
                  <a href={a.data.route}>{a.data.title}</a>
                </h2>
                <p class="reading-time">{minutes(a)} Minuten Lesezeit</p>
              </li>
            );
          })}
        </ol>
      </div>
    </aside>
    <div class="lead-column lead-stories-column">
      {rail.map((id, i) => (
        <ArticleCard article={byId(id)} priority={i === 0} />
      ))}
    </div>
  </section>
  <section class="wide-chapter">
    <Art id="anerkennung-bruecke" />
    <div class="chapter-copy">
      <p class="eyebrow accent">Erst prüfen. Dann planen.</p>
      <h2>Eine gute Hilfe braucht einen passenden Rahmen.</h2>
      <p>
        Aufgabe, Anerkennung und Rechnung: Zehn Fragen, die Sie vor dem ersten
        Termin klären können.
      </p>
      <a class="text-link" href="/anbieter-check/">
        Zum Anbieter-Check <span>↗</span>
      </a>
    </div>
  </section>
  {sections.map((s, i) => (
    <>
      <section class="container editorial-section">
        <div class="section-heading">
          <h2>{pillarName(s.pillar)}</h2>
          <a href={`/${s.pillar}/`}>
            Alle Beiträge <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div
          class:list={[
            "card-grid",
            { "two-up": s.ids.length === 2, "single-wide": s.ids.length === 1 },
          ]}
        >
          {s.ids.map((id) => (
            <ArticleCard article={byId(id)} />
          ))}
        </div>
      </section>
      {i === 0 && (
        <section class="dark-module">
          <div class="chapter-copy">
            <p class="eyebrow">Eine Bildgeschichte</p>
            <h2>
              Vom Anspruch
              <br />
              zur Entlastung.
            </h2>
            <p>
              Sechs Schritte. Eine Rechnung. Und die Frage, wann aus einem
              Budget wirklich Hilfe wird.
            </p>
            <a
              class="text-link"
              href="/bildgeschichten/vom-anspruch-zur-entlastung/"
            >
              Die Geschichte entdecken <span>↗</span>
            </a>
          </div>
          <Art id="toepfe-verbinden" />
        </section>
      )}
      {i === 1 && (
        <section class="container">
          <div class="tool-invitation">
            <p class="eyebrow accent">Der Budget-Check</p>
            <h2>
              Was ist möglich?
              <br />
              Und was bleibt übrig?
            </h2>
            <p>
              Rechnen Sie Begleitung und Pflegegeld zusammen. Mit sichtbaren
              Schritten und Eingaben, die in Ihrem Browser bleiben.
            </p>
            <a class="button" href="/budget-check/">
              Ihre Rechnung sortieren <span>↗</span>
            </a>
          </div>
        </section>
      )}
    </>
  ))}
  <section class="container editorial-section">
    <div class="section-heading">
      <h2>Die Redaktion</h2>
      <a href="/ueber-uns/">Lernen Sie uns kennen ↗</a>
    </div>
    <div class="editorial-note">
      <p class="eyebrow accent">Unser Anspruch</p>
      <h2>
        Die Regeln sind kompliziert genug.
        <br />
        Die Erklärung muss es nicht sein.
      </h2>
      <p>
        Wir unterscheiden verfügbare Budgets von tatsächlicher Erstattung. Und
        eine politische Ankündigung von einer Regel, die heute gilt.
      </p>
      <a class="text-link" href="/so-arbeiten-wir/">
        So arbeiten wir <span>↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
