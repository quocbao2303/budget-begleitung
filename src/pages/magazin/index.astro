---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Archive from "../../components/Archive.astro";
import { articles } from "../../lib/content";
const all = (await articles()).reverse();
---

<BaseLayout
  title="Das Magazin"
  description="Beiträge zur finanziellen Seite der Pflegebegleitung. Budgets verstehen, Unterstützung finden, Kosten einreichen und Reformen einordnen."
>
  <header class="page-heading">
    <p class="eyebrow accent">Klarheit beginnt mit einer guten Frage.</p>
    <h1>Das Magazin</h1>
    <p>
      Hier finden Sie unsere Beiträge zur finanziellen Seite der
      Pflegebegleitung. Beginnen Sie mit den Grundlagen oder wählen Sie die
      Frage, die gerade ansteht: ein Budget verstehen, Unterstützung finden,
      Kosten einreichen oder eine Reform einordnen.
    </p>
  </header>
  <Archive
    items={all.slice(0, 12)}
    all={all}
    total={18}
    next="/magazin/seite/2/"
    filters
  />
</BaseLayout>
